RAGELIT_ENVIRONMENT=local
RAGELIT_SECRET_KEY=change-me
RAGELIT_DATABASE_ADMIN_URL=postgresql+psycopg://ragelit_owner:ragelit_owner@localhost:5432/ragelit
RAGELIT_DATABASE_URL=postgresql+psycopg://ragelit_app:ragelit_app@localhost:5432/ragelit
RAGELIT_QDRANT_URL=http://localhost:6333
RAGELIT_ACCESS_TOKEN_MINUTES=15
RAGELIT_REFRESH_SESSION_DAYS=14
RAGELIT_MAX_UPLOAD_BYTES=26214400
RAGELIT_DATA_DIR=../data
RAGELIT_QDRANT_COLLECTION=ragelit_chunks
RAGELIT_LLM_MODEL=
RAGELIT_LLM_API_KEY=
RAGELIT_LLM_TIMEOUT_SECONDS=30
# Set RAGELIT_LLM_BASE_URL to an explicitly chosen compatible endpoint.
# Generation is disabled until the base URL and model are configured.
RAGELIT_ALLOWED_ORIGINS=["http://localhost:5173"]
RAGELIT_COOKIE_SECURE=false

POSTGRES_DB=ragelit
POSTGRES_OWNER_USER=ragelit_owner
POSTGRES_OWNER_PASSWORD=ragelit_owner
POSTGRES_APP_PASSWORD=ragelit_app
